# NOTE 1: pnpm 11.7.0's sqlite store index fails (ERR_SQLITE_ERROR) with a RELATIVE
# store-dir, and the default store location (~/.local/share/pnpm) is outside the
# sandbox-writable area. Every explicit pnpm install on the dev sandbox must pass an
# absolute in-workspace store dir:
#
#   pnpm install --store-dir "$PWD/.pnpm-store"
#
# CI (.github/workflows/ci.yml) does exactly this and caches that directory.
# .pnpm-store/ and .npmcache/ are gitignored.
#
# NOTE 2: verify-deps-before-run must stay OFF here. pnpm's pre-run dependency check
# shells out to `pnpm install` WITHOUT the caller's --store-dir override, so on this
# sandbox it hits the unwritable default store and dies (ERR_SQLITE_ERROR) before any
# script runs — making `pnpm -r build && pnpm -r test` fail for environment reasons.
# CI installs explicitly (frozen lockfile) before running scripts, so nothing is lost.
verify-deps-before-run=false
engine-strict=true
