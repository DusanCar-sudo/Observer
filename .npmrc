# NOTE: pnpm 11.7.0's sqlite store index fails (ERR_SQLITE_ERROR) with a RELATIVE
# store-dir, and the default store location (~/.local/share/pnpm) is outside the
# sandbox-writable area. Every pnpm install on the dev sandbox must therefore pass
# an absolute in-workspace store dir explicitly:
#
#   pnpm install --store-dir "$PWD/.pnpm-store"
#
# CI (.github/workflows/ci.yml) does exactly this and caches that directory.
# .pnpm-store/ and .npmcache/ are gitignored.
engine-strict=true
